<< lib/cpu/pdp7/SLPDP7Circuit.sleela
   SLeeLa Standard Library Definition.
   Definition: Defines SLPDP7Circuit, the circuit model of the DEC PDP-7
     (PDP-7 discrete-transistor Flip Chips). It states the logic family and its voltage thresholds, the
     supply rail, the clock and its phases, the functional blocks with width,
     depth, gate and transistor counts, two timing paths, four monitored nets
     and three semaphores.

   Provenance of the figures (checked means a source found on 2026-11-21 states it):
     clock      1 MHz, taken from the existing SLPDP7CPU model; not checked here.
     recalled   transistor count unknown; feature size unknown; supply -3000 mV.
                Recalled figures come from general knowledge and were not checked
                against a primary source in this session.
     derived    thresholds (derived for 0 V and -3 V negative logic); gate delay 41666 ps (derived from the rated clock, 24 gate levels per clock phase); edge time, fanout,
                block gate and transistor counts and depths, both timing paths,
                the power delivery network (system backplane: 10 milliohm, 50 nH, 10 uF bulk, 5 A for the processor boards), and the sizes of the design
                and GPU blocks built from the recalled design character. Derived numbers are
                planning figures, not measurements.
   The model stays at functional-block level. It is not a transistor netlist.

   Family: cpu. Extends SLCircuitModel. >>
#sleela 2.5
material;
class SLPDP7Circuit extends SLCircuitModel {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 39623;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-21";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "Digital Equipment Corporation";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "United States";
  String metaBirthDate = "2026-11-21";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 5;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
  void build() {
    SLLogicFamily f = new SLLogicFamily();
    f.configure("discrete-transistor", 0, -3000, 300);
    f.setThresholds(-1000, -2000, -200, -2800);
    f.setSpeed(41666, 62499, 3);
    f.setProvenance("thresholds derived for 0 V and -3 V negative logic; speed derived from the rated clock, 24 gate levels per clock phase");

    SLVoltageRail rail = new SLVoltageRail();
    rail.configure("supply", -3000, -3300, -2700);

    configure("DEC PDP-7", f, rail, 1000, 1);
    setWidths(18, 13);
    setTransistors(0);
    setKnown(0, 0, 1, 0);
    setProvenance("recalled: PDP-7 discrete-transistor Flip Chips; transistor count unknown");

    < Power delivery, derived: system backplane: 10 milliohm, 50 nH, 10 uF bulk, 5 A for the processor boards. >
    SLPowerNetwork pdn = setPowerNetwork(10000, 50000, 10000, 5000);
    pdn.setProvenance("derived: system backplane: 10 milliohm, 50 nH, 10 uF bulk, 5 A for the processor boards");

    SLCircuitBlock alu = addBlock("alu", "alu", 18, 7, 162, 648);
    alu.setProvenance("derived: parallel-prefix carry adder and logic unit, 4 transistors per gate");
    SLCircuitBlock regs = addBlock("register-file", "regfile", 36, 3, 36, 216);
    regs.setProvenance("derived: 2 registers of 18 bits at 6 transistors per bit");
    SLCircuitBlock dec = addBlock("instruction-decode", "decode", 18, 6, 288, 1152);
    dec.setProvenance("derived: decode and control sized at 16 gates per data bit");
    SLCircuitBlock bus = addBlock("bus-interface", "bus", 31, 3, 62, 248);
    bus.setProvenance("derived: address and data latches and drivers");
    SLCircuitBlock clk = addBlock("clock", "clock", 1, 4, 8, 32);
    clk.setProvenance("derived: clock buffer and phase generation");
    < Design character, recalled: single core, no caches, no FPU, no on-chip MMU. >
    setDesign(1, 1, 1, 1, 0);
    setCaches(0, 0, 0, 0, 0, 0);
    setUnits(0, 0, 0);
    setDesignProvenance("recalled: single core, no caches, no FPU, no on-chip MMU");
    buildDesign();
    SLCircuitBlock rest = addRemainder("other");

    SLCircuitPath add = addPath("alu-add", 50000);
    add.setPeriod(1000000);
    add.describe("derived: operand latch, 18-bit prefix carry, result latch in one clock phase");
    add.addStage("operand-latch", 41666);
    add.addStage("carry-18-bits", 291662);
    add.addStage("result-latch", 41666);
    add.constrain(41666, 10416, 20000);

    SLCircuitPath rf = addPath("register-read-bypass", 50000);
    rf.setPeriod(1000000);
    rf.describe("derived: register-file read, bypass mux, ALU input latch");
    rf.addStage("register-read", 124998);
    rf.addStage("bypass-mux", 83332);
    rf.addStage("input-latch", 41666);
    rf.constrain(41666, 10416, 20000);

    SLSignalQuality n0 = addNet("CLK");
    n0.setEdgeLimit(249996);
    SLSignalQuality n1 = addNet("A0");
    SLSignalQuality n2 = addNet("D0");
    SLSignalQuality n3 = addNet("RESET");

    SLCircuitSemaphore latchSem = addSemaphore("latch", 1, 2);
    SLCircuitSemaphore abus = addSemaphore("address-bus", 1, 2);
    SLCircuitSemaphore dbus = addSemaphore("data-bus", 1, 2);
  }

  < The CPU class this circuit models, configured and ready to run. >
  SLPDP7CPU cpuModel() {
    SLPDP7CPU c = new SLPDP7CPU();
    c.configure();
    return c;
  }

  < Check this circuit against its CPU class: name, rated clock and data width. >
  int linkCpu() {
    SLPDP7CPU c = cpuModel();
    return agreeWithCpu(c.architecture(), c.specClockMHz(), c.dataWidth());
  }
}
