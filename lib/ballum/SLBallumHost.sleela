<< lib/ballum/SLBallumHost.sleela
   SLeeLa Standard Library Definition.
   Definition: The Ballum program host: run a terminal or admin interface inside
   the white Ballum environment. >>
#sleela 2.5
material;
<< Family: ballum. SLBallumHost puts a real program, such as a terminal or an
   admin interface, on the Ballum fullscreen surface. The program runs on its
   own private display; Ballum receives its pixels and routes every key and
   mouse event to it one to one. The program enters with an effect (disintegrate,
   slide-left, slide-right, slide-up, slide-down, pixelize, fade and the rest of
   the catalog) and leaves with one. An APP NAME slot and a DATE TIME slot sit
   above the program; the native host reserves them for components that are
   added later.

   Typical use:
     SLBallumHost host = new SLBallumHost();
     host.create();
     host.open();                                  bind the primary display
     host.startProfile("xterm", "disintegrate", "fade");
     while (host.isRunning()) { host.step(); }     one call per frame
     print(host.exitReasonName());

   The user leaves with Ctrl+Alt+Esc. Every call validates its arguments in the
   native host and returns a status code mirroring SLBallumStatus (0 ok,
   1 invalid, 2 backend-unavailable, 4 display-not-found, 5 out-of-bounds,
   7 unsupported, 8 permission-denied); a host that cannot run reports the
   status instead of pretending. Arguments to startProgram are split on spaces,
   with no shell and no quoting. >>
class SLBallumHost {

  static final int STATE_IDLE = 0;
  static final int STATE_STARTING = 1;
  static final int STATE_ENTERING = 2;
  static final int STATE_RUNNING = 3;
  static final int STATE_LEAVING = 4;
  static final int STATE_DONE = 5;

  < native display id of the bound display, or -1 >
  int displayId;
  < the status of the most recent operation >
  int lastStatus;

  < Prepare the host. Call create() then open() before starting a program. >
  void create() {
    displayId = -1;
    lastStatus = 0;
  }

  < Bind the primary display (or the first one). Returns the status. >
  int open() {
    int st = uiBallumEnumerate();
    lastStatus = st;
    if (st != 0) { return st; }
    int n = uiBallumDisplayCount();
    if (n == 0) { lastStatus = 4; return lastStatus; }
    int idx = 0;
    int i = 0;
    while (i < n) {
      if (uiBallumDisplayPrimary(i) == 1) { idx = i; }
      i = i + 1;
    }
    displayId = uiBallumDisplayId(idx);
    return lastStatus;
  }

  boolean isOpen() { return displayId >= 0; }
  int display() { return displayId; }

  < ---- catalogs -------------------------------------------------------- >

  int profileCount() { return uiBallumHostProfileCount(); }
  String profileName(int index) { return uiBallumHostProfileName(index); }
  < the text the APP NAME component shows for a profile >
  String profileTitle(int index) { return uiBallumHostProfileTitle(index); }
  int transitionCount() { return uiBallumHostTransitionCount(); }
  String transitionName(int index) { return uiBallumHostTransitionName(index); }

  < ---- configuration (before start) ------------------------------------ >

  < Watch what the program draws through the X11 relay (see SLBallumInterpreter). >
  int observe(boolean on) {
    int v = 0;
    if (on) { v = 1; }
    lastStatus = uiBallumHostObserve(v);
    return lastStatus;
  }

  < headerHeight 0..512 px (0 = no header), enterMs 0..10000, maxSeconds 0 = unlimited >
  int configure(int headerHeight, int enterMs, int maxSeconds) {
    lastStatus = uiBallumHostConfigure(headerHeight, enterMs, maxSeconds);
    return lastStatus;
  }

  < ---- running a program ---------------------------------------------- >

  < Start a starter profile by name; enter and leave name transitions, or "" for the profile default. >
  int startProfile(String profile, String enter, String leave) {
    if (displayId < 0) { lastStatus = 4; return lastStatus; }
    lastStatus = uiBallumHostStart(displayId, profile, enter, leave);
    return lastStatus;
  }

  < Start any program; args are split on spaces (no shell, no quoting). >
  int startProgram(String program, String args, String enter, String leave) {
    if (displayId < 0) { lastStatus = 4; return lastStatus; }
    lastStatus = uiBallumHostStartProgram(displayId, program, args, enter, leave);
    return lastStatus;
  }

  < Advance one frame; returns the state. Call once per frame while running. >
  int step() { return uiBallumHostStep(); }
  int state() { return uiBallumHostState(); }
  String stateName() { return uiBallumHostStateName(uiBallumHostState()); }
  boolean isRunning() {
    int s = uiBallumHostState();
    return s != 0 && s != 5;
  }
  boolean isDone() { return uiBallumHostState() == 5; }
  int exitReason() { return uiBallumHostExitReason(); }
  String exitReasonName() { return uiBallumHostExitReasonName(uiBallumHostExitReason()); }

  < End the session at once, releasing the program, input grab and surface. >
  int stop() {
    lastStatus = uiBallumHostStop();
    return lastStatus;
  }

  int statusCode() { return lastStatus; }
  boolean ok() { return lastStatus == 0; }
  String lastMessage() { return uiBallumStatusName(lastStatus); }

  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  < Eleven catalogued attributes with getter/setter pairs, so a GUI, loader, >
  < or catalog can read and (where appropriate) override this record. >
  < Values are faithful to the real origin of the subject where publicly known. >
  String metaVersion = "1.0.0";
  int metaId = 11801;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-21";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "Ballum";
  String metaCorporation = "SLeeLa Project";
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-21";
  < maturity/robustness on a 1..10 scale >
  int metaScienceRating = 6;
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
}
