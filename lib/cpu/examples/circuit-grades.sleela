<< lib/cpu/examples/circuit-grades.sleela
   SLeeLa example: build, clock and grade the circuit model of every CPU in
   lib/cpu and of every SKU entry (the EPYC and Threadripper models). Each
   circuit is first linked to its CPU class (linkCpu), so a disagreement in
   name, rated clock or data width counts as a violation. Prints one line per
   circuit with its grade, score out of 10, total verification violations,
   timing violations, CPU-link mismatches, the power network result (settled
   die voltage, post-ramp ripple, peak supply current, settle time and its
   violations) and the design (execution style, cores, total cache,
   pipeline-stage slack and the share of a known transistor total that the
   named blocks explain), then the grade totals.
   See SLCircuitModel.circuitScore for how the grade is computed. >>
#sleela 2.5
import cpu;
class SLCircuitGradesExample {
  int gA;
  int gB;
  int gC;
  int gD;
  int gF;
  int failing;
  int unlinked;

  String designOf(SLCircuitModel m) {
    String stage = "stage=none";
    if (m.hasStagePath()) { stage = "stage slack " + m.stageSlackPs() + "ps"; }
    String budget = "budget unknown";
    if (m.publishedTransistors() > 0) { budget = "budget " + m.budgetPerMille() + "/1000"; }
    return "design " + m.styleName() + " cores=" + m.cores + " cache=" + m.cacheBytes() + "B " + stage + " " + budget;
  }

  void tally(String name, String dir, String grade, int score, int violations, int timing, SLPowerNetwork pdn, String design, int cpuBad) {
    String pw = "power=none";
    if (pdn != null) {
      int mv = (int) (pdn.settledVolts() * 1000.0);
      int ripple = (int) (pdn.rippleVolts() * 1000000.0);
      int peak = (int) (pdn.peakAmps() * 1000.0);
      int settleNs = (int) (pdn.settleSeconds() * 1000000000.0);
      pw = "power " + mv + "mV ripple " + ripple + "uV peak " + peak + "mA settle " + settleNs + "ns v=" + pdn.violations();
    }
    print(grade + "  " + score + "/10  violations=" + violations + "  timing=" + timing + "  cpu=" + cpuBad + "  " + dir + "  " + name + "  " + pw + "  " + design);
    if (grade == "A") { gA = gA + 1; }
    if (grade == "B") { gB = gB + 1; }
    if (grade == "C") { gC = gC + 1; }
    if (grade == "D") { gD = gD + 1; }
    if (grade == "F") { gF = gF + 1; }
    if (violations > 0) { failing = failing + 1; }
    if (cpuBad > 0) { unlinked = unlinked + 1; }
  }

  < One method per circuit, so each model and its CPU are released on return. >
  void m0() {
    SL6502Circuit m0 = new SL6502Circuit(); m0.build(); m0.linkCpu(); m0.runCycles(16);
    tally(m0.name(), "6502", m0.circuitGrade(), m0.circuitScore(), m0.verifyAll(), m0.timingViolations(), m0.powerNetwork(), designOf(m0), m0.cpuMismatchCount());
  }

  void m1() {
    SL68020Circuit m1 = new SL68020Circuit(); m1.build(); m1.linkCpu(); m1.runCycles(16);
    tally(m1.name(), "68020", m1.circuitGrade(), m1.circuitScore(), m1.verifyAll(), m1.timingViolations(), m1.powerNetwork(), designOf(m1), m1.cpuMismatchCount());
  }

