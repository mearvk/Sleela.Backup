<< lib/cpu/pdp8/SLPDP8CPU.sleela
   SLeeLa DEC PDP-8 CPU model.
   
   Functional architecture foundation; not a cycle-accurate emulator. Extends
   SLCPURuntime so, in addition to its hand-written PDP-8 semantics (12-bit
   accumulator/link, masked word memory, EAE/memory-extension feature gates), it
   inherits the resource-aware workload path (admit()/runWorkload()) and can run
   C, C++ or Sleela programs within an SLCPUResource grant on the canonical
   SLeeLa opcode substrate — the same contract every CPU in lib/cpu now honors.
   
   Family: cpu. Extends SLCPURuntime. >>
#sleela 2.5
material;
class SLPDP8CPU extends SLCPURuntime {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 10453;
  String metaAuthor = "Max Rupplin vs. Dr. Mrs. Elisabeth Harkins";
  String metaDate = "2026-10-16";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "none";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "International";
  String metaBirthDate = "2026-10-08";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 9;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
  String machineModel = "";
  boolean strictProfile = true;
  boolean extendedArithmeticEnabled = false;
  boolean memoryExtensionEnabled = false;
  int accumulator = 0;
  int link = 0;
  int instructionRegister = 0;
  int currentInstructionAddress = 0;
  int memoryWords = 4096;
  < 4096 words of 12-bit core memory >
  int[] memory;
  < Fail-closed checks record the reason here instead of throwing. >
  String lastError = "";
  int errorCount = 0;

  < Standard entry point: bring up the inherited runtime (12-bit data, 12-bit >
  < address, a small register file for AC/LINK/PC) and apply a default PDP-8/E >
  < profile. Call configureModel(...) to select a specific machine profile. >
  void configure() {
    < DEC PDP-8 (~0.67 MHz, rounded to 1); overclockable >
    setSpecClock(1);
    bringUp("DEC PDP-8", 12, 12, 4, 4096);
    configureModel("PDP-8/E", 4096, false, false);
  }

  void fail(String why) { lastError = why; errorCount = errorCount + 1; }

  < Select a machine profile. Returns false, and changes nothing, when the >
  < profile name is empty or the base memory is outside 1..4096 words. >
  boolean configureModel(String selectedMachineModel, int selectedMemoryWords, boolean enableEAE, boolean enableMemoryExtension) {
    if (selectedMachineModel == "") { fail("A PDP-8 machine profile is required"); return false; }
    if (selectedMemoryWords < 1 || selectedMemoryWords > 4096) {
      fail("Base PDP-8 memory must be 1..4096 words; configure documented memory extension separately");
      return false;
    }
    machineModel = selectedMachineModel;
    memoryWords = selectedMemoryWords;
    extendedArithmeticEnabled = enableEAE;
    memoryExtensionEnabled = enableMemoryExtension;
    memory = new int[4096];
    resetArchitecturalState();
    return true;
  }

  void resetArchitecturalState() {
    accumulator = 0;
    link = 0;
    instructionRegister = 0;
    currentInstructionAddress = 0;
    setEntryPoint(0);
  }

  < Keep the low 12 bits; correct for negative values too. >
  int maskWord12(int value) { return ((value % 4096) + 4096) % 4096; }

  < Read a word; out of range records an error and reads 0. >
  int readPdpWord(int address) {
    if (address < 0 || address >= memoryWords) { fail("PDP-8 memory address out of range: " + address); return 0; }
    return maskWord12(memory[address]);
  }

  < Write a word; out of range records an error and writes nothing. >
  boolean writePdpWord(int address, int value) {
    if (address < 0 || address >= memoryWords) { fail("PDP-8 memory address out of range: " + address); return false; }
    memory[address] = maskWord12(value);
    return true;
  }

  boolean setLink(int value) {
    if (value != 0 && value != 1) { fail("PDP-8 link must be 0 or 1"); return false; }
    link = value;
    return true;
  }

  < True when the feature is enabled, or when the profile is not strict. >
  boolean requireFeature(boolean enabled, String featureName) {
    if (!enabled && strictProfile) { fail("Unsupported PDP-8 feature: " + featureName); return false; }
    return true;
  }

  String getMachineModel() { return machineModel; }
  int getAccumulator() { return accumulator; }
  int getLink() { return link; }
  String getLastError() { return lastError; }
  int getErrorCount() { return errorCount; }

  < The physical circuit model of this processor: logic family, supply, clock, >
  < blocks, timing paths, nets and semaphores (see SLPDP8Circuit). It is built, clocked >
  < for 16 cycles and returned ready for verifyAll() and circuitGrade(). >
  < The circuit is told this CPU name, rated clock and width, and counts any mismatch. >
  SLPDP8Circuit circuitModel() {
    SLPDP8Circuit c = new SLPDP8Circuit();
    c.build();
    c.agreeWithCpu(architecture(), specClockMHz(), dataWidth());
    c.runCycles(16);
    return c;
  }

  String circuitGrade() {
    SLPDP8Circuit c = circuitModel();
    return c.circuitGrade();
  }
}
