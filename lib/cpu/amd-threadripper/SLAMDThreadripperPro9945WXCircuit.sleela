<< lib/cpu/amd-threadripper/SLAMDThreadripperPro9945WXCircuit.sleela
   SLeeLa Standard Library Definition.
   Definition: Defines SLAMDThreadripperPro9945WXCircuit, the circuit model of the AMD Ryzen Threadripper PRO 9945WX (Zen 5, 12C/24T).
     It extends SLAMDThreadripperCircuit, whose build() it replaces with this SKU.

   Provenance of the figures:
     repo       12 cores, 24 threads, 64 MB L3, 350 W TDP and the
                5400 MHz rated clock, from this folder SPECIFICATION.md and the
                SLAMDThreadripperPro9945WX class; not checked against AMD here.
     repo       Vcore 1200 mV nominal, 950 to 1450 mV window, from
                SLAMDThreadripperPlatform (the Zen 5 rail the repo states).
     recalled   Zen 5 on TSMC N4P (4 nm); per core 32 KB L1I, 48 KB L1D and
                1 MB L2; 8-wide out-of-order core, about 19 stages; AVX-512 on
                a 512-bit datapath. Transistor count unknown.
     derived    load current 291666 mA = TDP / Vcore nominal; power delivery
                network 30 micro-ohms, 50 pH, 1 mF (socket, package and die
                capacitance); thresholds, gate delay and block sizes as in
                SLCircuitModel. Derived numbers are planning figures.
   The model stays at functional-block level. It is not a transistor netlist.

   Family: cpu. Extends SLAMDThreadripperCircuit. >>
#sleela 2.5
material;
class SLAMDThreadripperPro9945WXCircuit extends SLAMDThreadripperCircuit {
  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  << Eleven catalogued attributes with getter/setter pairs, so a GUI, loader,
     or catalog can read and (where appropriate) override this record.
     Values are faithful to the subject's real origin where publicly known. >>
  String metaVersion = "1.0.0";
  int metaId = 39772;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-21";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "none";
  String metaCorporation = "AMD";
  < metaOrigin: National | <nation> | International | Galactic >
  String metaOrigin = "United States";
  String metaBirthDate = "2026-11-21";
  < metaScienceRating: maturity/robustness on a 1..10 scale >
  int metaScienceRating = 5;
  < metaNationalSchedule: a real, citable instrument or "none" >
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
  void build() {
    SLLogicFamily f = new SLLogicFamily();
    f.configure("CMOS", 4, 1200, 60);
    f.setThresholds(360, 840, 120, 1080);
    f.setSpeed(5, 7, 4);
    f.setProvenance("thresholds derived CMOS convention; gate delay 5 ps derived for a 3 to 4 nm process");

    SLVoltageRail rail = new SLVoltageRail();
    rail.configure("Vcore", 1200, 950, 1450);

    configure("AMD Ryzen Threadripper PRO 9945WX (Zen 5, 12C/24T)", f, rail, 5400000, 1);
    setWidths(64, 48);
    setTransistors(0);
    setKnown(0, 1, 1, 1);
    setProvenance("repo: 12 cores, 64 MB L3, 350 W; recalled: Zen 5, N4P");

    < Power delivery, derived: 291666 mA is the 350 W TDP at the 1200 mV Vcore. >
    SLPowerNetwork pdn = setPowerNetwork(30, 50, 1000000, 291666);
    pdn.setProvenance("derived: SP5 or sTR5 socket and package, 30 micro-ohms, 50 pH, 1 mF, 291666 mA from 350 W at 1.2 V");

    SLCircuitBlock alu = addBlock("alu", "alu", 64, 8, 576, 3456);
    alu.setProvenance("derived: parallel-prefix adder and logic unit");
    SLCircuitBlock regs = addBlock("register-file", "regfile", 1024, 6, 1024, 6144);
    regs.setProvenance("derived: 16 architectural registers of 64 bits");
    SLCircuitBlock dec = addBlock("instruction-decode", "decode", 64, 6, 1024, 6144);
    dec.setProvenance("derived: decode and control");
    SLCircuitBlock bus = addBlock("bus-interface", "bus", 112, 3, 224, 1344);
    bus.setProvenance("derived: address and data latches and drivers");
    SLCircuitBlock clk = addBlock("clock", "clock", 1, 4, 8, 48);
    clk.setProvenance("derived: clock buffer and phase generation");

    < Design character: 12 Zen 5 cores, 24 threads, 64 MB L3. >
    setDesign(12, 2, 19, 8, 4);
    setCaches(32768, 49152, 0, 12582912, 67108864, 0);
    setUnits(1, 2, 512);
    setDesignProvenance("repo: 12 cores and 64 MB L3; recalled: Zen 5 core with 32 KB L1I, 48 KB L1D, 1 MB L2 per core");
    buildDesign();

    SLCircuitPath add = addPath("alu-add", 9);
    add.setPeriod(185);
    add.describe("derived: operand latch, 64-bit prefix carry, result latch in one clock");
    add.addStage("operand-latch", 5);
    add.addStage("carry-64-bits", 40);
    add.addStage("result-latch", 5);
    add.constrain(5, 1, 3);

    SLCircuitPath rf = addPath("register-read-bypass", 9);
    rf.setPeriod(185);
    rf.describe("derived: register-file read, bypass mux, ALU input latch");
    rf.addStage("register-read", 30);
    rf.addStage("bypass-mux", 10);
    rf.addStage("input-latch", 5);
    rf.constrain(5, 1, 3);

    SLSignalQuality n0 = addNet("CLK");
    n0.setEdgeLimit(28);
    SLSignalQuality n1 = addNet("A0");
    SLSignalQuality n2 = addNet("D0");
    SLSignalQuality n3 = addNet("RESET");

    SLCircuitSemaphore latchSem = addSemaphore("latch", 1, 2);
    SLCircuitSemaphore abus = addSemaphore("address-bus", 1, 2);
    SLCircuitSemaphore dbus = addSemaphore("data-bus", 1, 2);
  }

  < The CPU class this circuit models, configured and ready to run. >
  SLAMDThreadripperPro9945WX cpuModel() {
    SLAMDThreadripperPro9945WX c = new SLAMDThreadripperPro9945WX();
    c.configure();
    return c;
  }

  < Check this circuit against its CPU class: name, rated clock and data width. >
  int linkCpu() {
    SLAMDThreadripperPro9945WX c = cpuModel();
    return agreeWithCpu(c.architecture(), c.specClockMHz(), c.dataWidth());
  }
}
