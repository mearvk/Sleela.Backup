<< lib/ballum/SLBallumCharSource.sleela
   SLeeLa Standard Library Definition.
   Definition: Ballum's end of sourcing characters: take in a pixel map or a known
   charset and give Ballum glyphs it can draw and recognise. >>
#sleela 2.5
material;
<< Family: ballum. A character source holds glyphs. It is filled from a PIXEL MAP,
   an image cut into a grid of equal cells whose cells hold the characters of a
   KNOWN CHARSET in order, and it is what lets Ballum turn the glyph images a
   hosted program draws back into characters (and draw characters of its own).

   Known charsets: ascii (95 characters), latin1 (191), digits (10), alnum (62).
   The pixel map is a binary PGM file (P5, 8 bit), the plainest lossless image
   format, so any tool can make one. Dark ink on a light page by default; set
   lightInk for the reverse. Ballum ships no font, so no font licence is bundled:
   the caller brings the glyphs.

   Typical use:
     SLBallumCharSource chars = new SLBallumCharSource();
     chars.create();
     chars.loadPgm("atlas.pgm", 8, 16, "ascii", 0, false);
     print(chars.glyphCount());

   Load before a session starts; a running session reads the source, so changes
   are refused until it has ended. Status codes mirror SLBallumStatus. >>
class SLBallumCharSource {

  < the status of the most recent operation >
  int lastStatus;

  void create() { lastStatus = 0; }

  < ---- the known charsets ---- >
  int charsetCount() { return uiBallumCharsetCount(); }
  String charsetName(int index) { return uiBallumCharsetName(index); }
  < how many characters the charset holds >
  int charsetSize(int index) { return uiBallumCharsetSize(index); }

  < ---- the glyphs ---- >
  < Add a pixel map: cells of cellW x cellH holding the charset in order, as font family 0..15. >
  int loadPgm(String path, int cellW, int cellH, String charset, int family, boolean lightInk) {
    int ink = 0;
    if (lightInk) { ink = 1; }
    lastStatus = uiBallumCharsourceLoadPgm(path, cellW, cellH, charset, family, ink);
    return lastStatus;
  }

  < Remove every glyph. >
  int clear() {
    lastStatus = uiBallumCharsourceClear();
    return lastStatus;
  }

  int glyphCount() { return uiBallumCharsourceGlyphCount(); }

  int statusCode() { return lastStatus; }
  boolean ok() { return lastStatus == 0; }
  String lastMessage() { return uiBallumStatusName(lastStatus); }

  < ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >
  < Eleven catalogued attributes with getter/setter pairs, so a GUI, loader, >
  < or catalog can read and (where appropriate) override this record. >
  < Values are faithful to the real origin of the subject where publicly known. >
  String metaVersion = "1.0.0";
  int metaId = 11803;
  String metaAuthor = "Kiro Agent";
  String metaDate = "2026-11-21";
  String metaCopyright = "SLeeLa project";
  String metaTrademark = "Ballum";
  String metaCorporation = "SLeeLa Project";
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-21";
  < maturity/robustness on a 1..10 scale >
  int metaScienceRating = 5;
  String metaNationalSchedule = "none";

  String getMetaVersion() { return metaVersion; }
  void setMetaVersion(String v) { metaVersion = v; }
  int getMetaId() { return metaId; }
  void setMetaId(int v) { metaId = v; }
  String getAuthor() { return metaAuthor; }
  void setAuthor(String v) { metaAuthor = v; }
  String getDate() { return metaDate; }
  void setDate(String v) { metaDate = v; }
  String getCopyright() { return metaCopyright; }
  void setCopyright(String v) { metaCopyright = v; }
  String getTrademark() { return metaTrademark; }
  void setTrademark(String v) { metaTrademark = v; }
  String getCorporation() { return metaCorporation; }
  void setCorporation(String v) { metaCorporation = v; }
  String getOrigin() { return metaOrigin; }
  void setOrigin(String v) { metaOrigin = v; }
  String getBirthDate() { return metaBirthDate; }
  void setBirthDate(String v) { metaBirthDate = v; }
  int getScienceRating() { return metaScienceRating; }
  void setScienceRating(int v) { metaScienceRating = v; }
  String getNationalSchedule() { return metaNationalSchedule; }
  void setNationalSchedule(String v) { metaNationalSchedule = v; }
}
